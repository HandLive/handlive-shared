{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handlive.app/schemas/v1/pair-confirm.schema.json",
  "title": "HandLive — pair/confirm (C→S)",
  "description": "PAIR-01 API 4. Unencrypted payload; sig = Ed25519(client ik_sig, attestation of 0.6.2).",
  "type": "object",
  "required": ["op", "data"],
  "additionalProperties": false,
  "properties": {
    "op": { "const": "confirm" },
    "data": {
      "type": "object",
      "required": ["pair_id", "created_at", "sig", "prk_check", "mac"],
      "additionalProperties": false,
      "properties": {
        "pair_id": {
          "description": "UUIDv4 generated by the client.",
          "$ref": "common.schema.json#/$defs/uuid-v4"
        },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "sig": { "$ref": "common.schema.json#/$defs/b64u-64" },
        "prk_check": {
          "description": "HMAC-SHA256(PRK, \"HL1|prk-check-c|\" ‖ pair_id).",
          "$ref": "common.schema.json#/$defs/b64u-32"
        },
        "mac": { "$ref": "common.schema.json#/$defs/b64u-32" }
      }
    }
  }
}
